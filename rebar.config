{erl_opts, [debug_info]}.
{minimum_otp_vsn, "27"}.
{deps, []}.
{ct_opts, [{ct_hooks, [cth_surefire]}]}.
%% HTTP/TLS applications are started by the caller and still need analysis types.
{dialyzer, [{plt_extra_apps, [inets, ssl, public_key, crypto, asn1]}]}.

%% Maintainer tools: exact pins; consumers do not load project_plugins.
{project_plugins, [{rebar3_hex, "7.0.10"}, {rebar3_ex_doc, "0.2.30"}]}.

%% ExDoc configuration
{ex_doc, [
  {extras, ["README.md", "CHANGELOG.md", "AGENTS.md", "docs/releases.md"]},
  {main, "README.md"},
  {source_url, "https://github.com/stritzinger/trellang"}
]}.

%% Hex: build & upload docs to HexDocs when publishing
{hex, [{doc, ex_doc}]}.

%% relx release skeleton for local runs
{relx, [
  {release, {trellang, semver}, [trellang]}
]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [trellang]}
]}.
